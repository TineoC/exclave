{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "exclave release",
  "description": "A self-describing product release. Carries its own rules about where it may be installed, so the decision can be made inside an environment that has been offline for months.",
  "type": "object",
  "required": ["product", "version", "channel", "components"],
  "properties": {
    "product": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" },
    "channel": { "enum": ["stable", "candidate", "edge"] },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "image"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string" },
          "image": {
            "type": "string",
            "description": "Digest-pinned reference. Tags are mutable; an assessor will ask."
          }
        }
      }
    },
    "requires": {
      "type": "object",
      "properties": {
        "kubernetes": { "type": "string", "description": "semver range, e.g. \">=1.28 <1.32\"" },
        "schema": { "type": "integer", "minimum": 0, "description": "monotonic floor" },
        "platform": { "type": "string", "description": "upgrade path: minimum installed version this release can migrate from" }
      }
    },
    "forbids": {
      "type": "object",
      "properties": {
        "environmentTier": { "type": "array", "items": { "type": "string" } }
      }
    },
    "allowedClassifications": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Allow list. Omit or leave empty for permissive."
    },
    "provenance": {
      "type": "object",
      "properties": {
        "sbom": { "type": "string" },
        "attestation": { "type": "string" }
      }
    }
  }
}
